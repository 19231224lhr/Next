+	if e != nil {
+		t.Fatal(e)
+	}
+	var online atomic.Bool
+	var calls atomic.Int32
+	h := Handler(map[protocol.PublicKey]*wallet.Wallet{owner: w}, nil)
+	srv := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
