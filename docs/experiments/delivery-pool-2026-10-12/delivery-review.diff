+	if e = receiveDB.View(func(v state.ReadView) error {
+		_, e := v.Get(wallet.DirectCoinKey(p.Certificate.Summary.OutputID(0), 0))
+		return e
+	}); e != nil {
+		t.Fatal(e)
+	}
+	cancel()
+	if e = <-done; e != nil {
+		t.Fatal(e)
+	}
+}
