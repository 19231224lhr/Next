+func TestDirectPreparedEncodingIsolatesMutableConsumers(t *testing.T) {
+	_, r, payments := directRelayFixture(t, 1)
+	fact := payments[0].Certificate.QC.Fact
+	p, _, _ := r.directPending(fact)
+	prepared, err := r.prepareDirectPending(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	install := bytes.Clone(prepared.installBytes)
+	submit := bytes.Clone(prepared.submissionBytes)
+	r.Public = relayPublic{submit: func(_ context.Context, raw []byte) error { raw[0] ^= 1; return nil }}
+	members := r.Members[p.Origin]
+	members[0] = byteRelayInstaller{relayInstaller: relayInstaller{}, installBytes: func(_ context.Context, raw []byte) error { raw[0] ^= 1; return nil }}
+	members[1] = relayInstaller{install: func(_ context.Context, payment protocol.DirectPayment) error {
+		payment.Tx.Auth[0].Signature[0] ^= 1
+		return nil
+	}}
+	r.Members[p.Origin] = members
+	decode := func() (directPreparedPayment, error) { return prepared, nil }
+	for _, target := range []int{-1, 0, 1, -1, 0, 1} {
+		if err := r.runDirectTask(context.Background(), directTask{fact, target}, decode); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !bytes.Equal(install, prepared.installBytes) || !bytes.Equal(submit, prepared.submissionBytes) {
+		t.Fatal("consumer mutated retained encoding")
+	}
+}
