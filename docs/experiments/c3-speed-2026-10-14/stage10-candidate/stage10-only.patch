+func TestDirectInstallIgnoresPublicEncodingFailure(t *testing.T) {
+	_, r, payments := directRelayFixture(t, 1)
+	fact := payments[0].Certificate.QC.Fact
+	p, _, _ := r.directPending(fact)
+	prepared, err := r.prepareDirectPending(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared.submissionErr = protocol.ErrEncoding
+	decode := func() (directPreparedPayment, error) { return prepared, nil }
+	if err := r.runDirectTask(context.Background(), directTask{fact, 0}, decode); err != nil {
+		t.Fatal("INSTALL inherited public encoding failure", err)
+	}
+	if err := r.runDirectTask(context.Background(), directTask{fact, -1}, decode); err != protocol.ErrEncoding {
+		t.Fatal("PUBLIC lost encoding failure", err)
+	}
+}
