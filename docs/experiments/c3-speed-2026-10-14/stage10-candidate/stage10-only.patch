+func TestDirectOutboxPreparationReuseBoundAndReplacement(t *testing.T) {
+	_, r, payments := directRelayFixture(t, 1)
+	p, _, _ := r.directPending(payments[0].Certificate.QC.Fact)
+	key := state.Key(state.KeyOutbox, p.Fact[:])
+	raw, _ := json.Marshal(p)
+	baseSize := len(key) + len(raw) + len(p.Certificate) + len(p.Attempt)
+	c := newDirectOutboxCache(2, baseSize+2*len(p.Certificate))
+	snapshot, _ := c.snapshot(key, raw)
+	calls := 0
+	prepare := func(p state.Outbox) (directPreparedPayment, error) { calls++; return r.prepareDirectPending(p) }
+	a := c.preparation(key, snapshot, prepare)
+	b := c.preparation(key, snapshot, prepare)
+	first, err := a()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.submissionErr != nil || len(first.submissionBytes) != len(first.installBytes) {
+		t.Fatal("public encoding exceeded reserved INSTALL-sized budget", first.submissionErr)
+	}
+	second, err := b()
+	if err != nil || calls != 1 || &first.installBytes[0] != &second.installBytes[0] {
+		t.Fatal("preparation not reused", calls, err)
+	}
+	if c.bytes != baseSize+2*len(p.Certificate) || c.bytes > c.maxBytes {
+		t.Fatal("encoded preparation budget not reserved", c.bytes)
+	}
+	p.NextSubmitUnixNS = 99
+	changed, _ := json.Marshal(p)
+	snapshot, _ = c.snapshot(key, changed)
+	c.preparation(key, snapshot, prepare)()
+	if calls != 2 {
+		t.Fatal("raw replacement retained preparation")
+	}
+	// Captured preparation survives eviction, and oversized preparation remains
+	// usable without exceeding the cache budget.
+	c.snapshot([]byte("other"), changed)
+	if _, err := a(); err != nil || calls != 2 {
+		t.Fatal("eviction broke captured preparation", err)
+	}
+	c = newDirectOutboxCache(2, baseSize)
+	snapshot, _ = c.snapshot(key, raw)
+	c.preparation(key, snapshot, prepare)()
+	c.preparation(key, snapshot, prepare)()
+	if calls != 4 || c.bytes > c.maxBytes {
+		t.Fatal("oversized preparation retained", calls)
+	}
+}
