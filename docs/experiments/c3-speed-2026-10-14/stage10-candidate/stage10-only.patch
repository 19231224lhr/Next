+func TestDirectOutboxPreparationCachesErrorUntilReplacement(t *testing.T) {
+	_, r, payments := directRelayFixture(t, 1)
+	p, _, _ := r.directPending(payments[0].Certificate.QC.Fact)
+	valid := bytes.Clone(p.Certificate)
+	p.Certificate = []byte("invalid encoded payment")
+	key := state.Key(state.KeyOutbox, p.Fact[:])
+	raw, _ := json.Marshal(p)
+	c := newDirectOutboxCache(2, 1<<20)
+	snapshot, _ := c.snapshot(key, raw)
+	calls := 0
+	prepare := func(p state.Outbox) (directPreparedPayment, error) { calls++; return r.prepareDirectPending(p) }
+	for i := 0; i < 2; i++ {
+		if _, err := c.preparation(key, snapshot, prepare)(); err == nil {
+			t.Fatal("invalid certificate accepted")
+		}
+	}
+	if calls != 1 {
+		t.Fatal("identical error reverified", calls)
+	}
+	p.Certificate = valid
+	raw, _ = json.Marshal(p)
+	snapshot, _ = c.snapshot(key, raw)
+	if _, err := c.preparation(key, snapshot, prepare)(); err != nil || calls != 2 {
+		t.Fatal("replacement retained old error", err, calls)
+	}
+}
