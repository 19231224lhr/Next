+	if e != nil {
+		t.Fatal(e)
+	}
+	requests := make([]protocol.DirectRequest, 3)
+	for i := range requests {
+		requests[i] = c3Build(t, f, p, i, nil)
+	}
+	results := make(chan error, 3)
+	var wg sync.WaitGroup
+	for _, r := range requests {
