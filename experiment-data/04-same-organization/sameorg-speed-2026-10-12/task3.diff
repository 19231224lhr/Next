+		current, found, e = state.Load[protocol.PoolCertificate](v, PoolReceiptKey(c.Action.Pool))
+		return e
+	}); err != nil {
+		return err
+	}
+	if !found || poolCertificateIdentity(current) != poolCertificateIdentity(c) {
+		return protocol.ErrAuth
+	}
