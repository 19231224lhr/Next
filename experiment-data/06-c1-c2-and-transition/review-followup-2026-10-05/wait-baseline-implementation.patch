+"""Matched fast/wallet-wait/member-ready chains on a fresh source copy.
+
+Waiting adds a client observation gate, not a different payment protocol.
+Three routed members must observe the exact parent; fee inputs are distinct
+genesis outputs installed before member HTTP startup. The client validates
+the immediate principal and genesis fee fixture before opening each gate.
+"""
+import argparse
+from datetime import datetime, timezone, timedelta
+import hashlib
+import json
+import os
+import platform
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import time
+import urllib.request
+
+
+def write(path, data):
+    path.write_text(json.dumps(data, indent=2) + '\n')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--root', type=Path, required=True)
+    parser.add_argument('--commit', required=True)
