+func receiptBody(t *testing.T, b *types.Block) []byte {
+	t.Helper()
+	pb, err := b.ToProto()
+	readerOK(t, err)
+	raw, err := pb.Marshal()
+	readerOK(t, err)
+	return raw
+}
